{
  "author": {
    "email": "dario@casertano.name",
    "name": "Dario Casertano (DarCas)",
    "url": "https://dariocasertano.com"
  },
  "bugs": {
    "url": "https://github.com/DarCas/smart-dns-promises/issues"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "20 || >= 22"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./min": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.min.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.min.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://smartdns.os.darcas.app",
  "description": "Zero-dependency DNS resolver for Node.js with TTL-aware caching, request deduplication and stale-while-revalidate — 9 configurable providers, built for fetch and axios.",
  "keywords": [
    "dns",
    "dns-resolver",
    "dns-cache",
    "dns-lookup",
    "nodejs",
    "typescript",
    "axios",
    "fetch",
    "caching",
    "ttl",
    "stale-while-revalidate",
    "zero-dependency",
    "deduplication",
    "performance"
  ],
  "license": "MIT",
  "main": "./dist/commonjs/index.js",
  "module": "./dist/esm/index.js",
  "name": "@darcas/smart-dns-promises",
  "repository": {
    "type": "git",
    "url": "https://github.com/DarCas/smart-dns-promises"
  },
  "scripts": {
    "build": "rm -rf ./dist && npm run build:esm && npm run build:esm-pkg && npm run build:cjs && npm run cjs && npm run esm",
    "build:esm": "tsc --outDir dist/esm",
    "build:cjs": "tsc --outDir dist/commonjs --module commonjs --moduleResolution node10 && node -e \"const fs = require('fs'); fs.writeFileSync('dist/commonjs/package.json', JSON.stringify({ type: 'commonjs' }, null, 2) + '\\n')\"",
    "build:esm-pkg": "node -e \"require('fs').writeFileSync('dist/esm/package.json', JSON.stringify({ type: 'module' }, null, 2) + '\\n')\"",
    "cjs": "esbuild --minify --sourcemap --bundle dist/commonjs/index.js --outfile=dist/commonjs/index.min.js --format=cjs --platform=node",
    "deploy": "npm run build && npm publish --access public",
    "esm": "esbuild --minify --sourcemap --bundle dist/esm/index.js --outfile=dist/esm/index.min.js --format=esm --platform=node",
    "test": "vitest run"
  },
  "type": "module",
  "types": "./dist/commonjs/index.d.ts",
  "version": "1.2.0"
}
